{
  "name": "@artemiskit/mcp-docker-sandbox",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./cli": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "bin": {
    "mcp-docker-sandbox": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && bun build ./src/index.ts ./src/cli.ts --outdir ./dist --target bun",
    "start": "bun run ./src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.30.0" },
  "devDependencies": { "@types/bun": "^1.1.0", "typescript": "^5.3.0" }
}
