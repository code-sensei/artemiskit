{
  "name": "@artemiskit/adapter-trueforge",
  "version": "0.1.1",
  "description": "TrueForge agent-harness adapter for ArtemisKit",
  "type": "module",
  "license": "Apache-2.0",
  "author": "code-sensei",
  "repository": {
    "type": "git",
    "url": "https://github.com/code-sensei/artemiskit.git",
    "directory": "packages/adapters/trueforge"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && bun build ./src/index.ts --outdir ./dist --target bun --external @artemiskit/core",
    "typecheck": "tsc --noEmit",
    "test": "bun test --preload ./src/test-preload.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@artemiskit/core": "workspace:*",
    "@truefoundry/trueforge-sdk": "0.1.3"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.3.0"
  }
}
